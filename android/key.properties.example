# Copy to android/key.properties (git-ignored) and fill in. NEVER commit the real file, the keystore (*.jks / *.keystore) or the passwords.
# storeFile is resolved relative to android/app/ (e.g. ../keystore/eldermin-teacher-upload.jks, or an absolute path outside the repo).
# Create an upload key once:  keytool -genkey -v -keystore ~/eldermin-teacher-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=<path to the .jks file>
